# Anthropic (LLM parser + shortlist explanations). Without it, regex fallback is used.
ANTHROPIC_API_KEY=

# Supabase auth (optional). Without these, users and prefs live in localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (OAuth redirect, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
